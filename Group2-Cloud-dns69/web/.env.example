# ── DNS69 web tier ──────────────────────────────────────────
# ปลายทางของ app tier ที่ Next.js จะ proxy /api/* ไปให้ (ฝั่ง server เท่านั้น)
#   บนเครื่อง: http://localhost:4000
#   บน AWS:   http://internal-dns69-app-alb-xxxx.ap-southeast-1.elb.amazonaws.com
API_ORIGIN=http://localhost:4000

# ต้องเป็นค่าเดียวกับ JWT_SECRET ของ api/ — middleware ใช้ตรวจลายเซ็น session
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
