{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadOnlyTheWebSecret",
      "Effect": "Allow",
      "Action": "secretsmanager:GetSecretValue",
      "Resource": "arn:aws:secretsmanager:ap-southeast-1:ACCOUNT_ID:secret:dns69/web-*"
    },
    {
      "Sid": "DownloadReleaseOnly",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::RELEASE_BUCKET/dns69.zip"
    }
  ]
}
