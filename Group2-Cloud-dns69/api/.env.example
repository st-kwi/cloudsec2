# ── DNS69 app tier ──────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ฐานข้อมูล — บน AWS คือ endpoint ของ RDS
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dns69
DB_USER=dns69_app
DB_PASSWORD=CHANGE_ME
# บน RDS ตั้ง true เสมอ (เข้ารหัสระหว่าง app tier กับ DB)
DB_SSL=false

# สร้างด้วย: openssl rand -base64 48   (ต้องยาวอย่างน้อย 32 ตัว)
# ต้องเป็นค่าเดียวกับ JWT_SECRET ของ web/
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# บน AWS: ใส่ชื่อ secret แล้วระบบจะดึง DB_PASSWORD / JWT_SECRET ให้เอง
# ปล่อยว่างไว้ตอนรันบนเครื่องตัวเอง
SECRETS_MANAGER_SECRET_ID=
AWS_REGION=ap-southeast-1
